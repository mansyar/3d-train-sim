{
  "name": "tiny-tracks",
  "version": "0.11.0",
  "private": true,
  "description": "A web-based 3D toy train table for toddlers — lay the track, press the button, watch your train go.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm exec biome check . && pnpm exec tsc --noEmit && pnpm test",
    "check:fix": "pnpm exec biome check . --write",
    "e2e": "pnpm build && playwright test --grep @smoke",
    "e2e:full": "pnpm build && playwright test --project=tablet --grep-invert @ci",
    "e2e:file": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@playwright/test": "^1.62.1",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.3.0",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "howler": "^2.2.4",
    "idb": "^8.0.3",
    "three": "^0.185.1"
  }
}
